# ==============================================================================
# LearnLoop Environment Variables Configuration (.env.example)
# Copy this file to .env and configure with your credentials.
# Note: AI Keys and Supabase Service Role keys are used ONLY on the server.
# ==============================================================================

# Node / Express Server Port
PORT=3001

# Groq AI Provider API Key (Kept strictly server-side for AI inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase Persistence Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Remote Sandboxed Code Execution Service URL (e.g. Judge0 or Piston)
# If left empty, LearnLoop uses safe client-side Web Worker sandboxing with strict timeouts.
CODE_SANDBOX_API_URL=
CODE_SANDBOX_API_KEY=
